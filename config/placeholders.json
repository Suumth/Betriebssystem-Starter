{
  "exampleConfig": "config/starter.config.example",
  "localConfig": "setup.local.env",
  "requiredFields": [
    "PROJECT_NAME",
    "GITHUB_OWNER",
    "GITHUB_REPO",
    "PROJECT_REPO_URL",
    "AI_VAULT_PATH",
    "LOCAL_CHECKOUT_PATH"
  ],
  "placeholders": [
    {
      "placeholder": "<PROJECT_NAME>",
      "fields": ["PROJECT_NAME"],
      "required": true,
      "meaning": "Visible project name"
    },
    {
      "placeholder": "<OWNER>/<REPO>",
      "fields": ["GITHUB_OWNER", "GITHUB_REPO"],
      "required": true,
      "meaning": "GitHub owner and repository name"
    },
    {
      "placeholder": "<PROJECT_REPO_URL>",
      "fields": ["PROJECT_REPO_URL"],
      "required": true,
      "meaning": "Canonical GitHub repository URL"
    },
    {
      "placeholder": "<PROJECT_MD_GITHUB_URL>",
      "fields": ["PROJECT_MD_GITHUB_URL", "PROJECT_REPO_URL"],
      "required": true,
      "meaning": "GitHub URL for the project's PROJECT.md file; derived from PROJECT_REPO_URL when not set explicitly"
    },
    {
      "placeholder": "<LOCAL_CHECKOUT_PATH>",
      "fields": ["LOCAL_CHECKOUT_PATH"],
      "required": true,
      "meaning": "Local checkout path for the project repository"
    },
    {
      "placeholder": "<AI_VAULT_PATH>",
      "fields": ["AI_VAULT_PATH"],
      "required": true,
      "meaning": "Local AI Vault path"
    },
    {
      "placeholder": "<AI_OS_METHOD_REPO_URL>",
      "fields": ["AI_OS_METHOD_REPO_URL"],
      "required": false,
      "meaning": "URL of the AI-Betriebssystem method source repository, if the project references it as an external method repo"
    }
  ],
  "setupMayUpdate": [
    "PROJECT.md",
    "AGENTS.md",
    ".github/labels.yml",
    ".github/ISSUE_TEMPLATE/task.md",
    ".github/pull_request_template.md",
    "docs/project-brief.md",
    "ai-vault/02_Projects/"
  ],
  "setupMustNotOverwrite": [
    "README.md",
    "START_HERE.md",
    "ai-betriebssystem/",
    "docs/",
    "public-readiness/",
    "scripts/",
    "config/"
  ]
}
